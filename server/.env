PORT=5000

# =========================================================================
# MongoDB Connection Configuration
# =========================================================================
# Option 1: MongoDB Atlas Cloud (Recommended for production / cloud DB)
# Replace with your connection string from mongodb.com:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/projectpartner?retryWrites=true&w=majority
#
# Option 2: Local MongoDB Service (If you have MongoDB Community Server installed)
# MONGODB_URI=mongodb://127.0.0.1:27017/projectpartner
#
# Option 3: Zero-Setup (Default)
# If local MongoDB is not running, ProjectPartner automatically runs on the
# high-speed academic embedded database with zero configuration needed.
MONGODB_URI=mongodb://127.0.0.1:27017/projectpartner

JWT_SECRET=projectpartner_super_secret_jwt_key_2026_academic_prod
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
